# Developer toolchain for SwiftBaseClassWAC.
# Install everything with:  brew bundle
# (App dependencies are managed with Swift Package Manager, not Homebrew.)

brew "swiftlint"   # linting (.swiftlint.yml)
brew "swiftformat" # formatting (.swiftformat)
brew "lefthook"    # git hooks (lefthook.yml)
brew "xcbeautify"  # readable xcodebuild output (used by scripts/ and CI)
