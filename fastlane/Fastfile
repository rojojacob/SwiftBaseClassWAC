# fastlane Fastfile
# Run a lane with:  bundle exec fastlane <lane>
# Docs: https://docs.fastlane.tools
#
# Prerequisites (one-time): see docs/RELEASE_SETUP.md
#   - `bundle install`  (installs fastlane from the Gemfile)
#   - A private "match" repo for signing assets (set MATCH_GIT_URL)
#   - An App Store Connect API key (.p8) + Key ID + Issuer ID.
#
# Credentials are read from the environment (see fastlane/.env.example).
# The API key is supplied to match/pilot/deliver as a JSON file via
# `api_key_path` (generated locally / from CI secrets; gitignored).

default_platform(:ios)

SCHEME = "SwiftBaseClassWAC"
PROJECT = "SwiftBaseClassWAC/SwiftBaseClassWAC.xcodeproj"
ASC_KEY = "fastlane/asc_api_key.json"

# macOS system Ruby links LibreSSL, whose AES-GCM binding (match's default v2
# encryption) is broken; legacy AES-256-CBC works and is still decryptable by
# OpenSSL-3 machines (e.g. CI). Force it so match storage is portable.
MATCH_LEGACY = true

platform :ios do
  desc "Run the full test suite (mirrors CI)"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: ["iPhone 16"]
    )
  end

  desc "Generate / sync App Store signing assets via match"
  lane :certificates do
    match(type: "appstore", api_key_path: ASC_KEY, force_legacy_encryption: MATCH_LEGACY)
  end

  desc "Build a signed .ipa and upload to TestFlight (internal + external testing)"
  lane :beta do
    # Sync signing assets from the private match repo (read-only on CI).
    match(type: "appstore", readonly: is_ci, api_key_path: ASC_KEY, force_legacy_encryption: MATCH_LEGACY)

    # Unique, always-increasing build number set at build time — no agvtool /
    # apple-generic versioning required, and no version churn committed to git.
    build_number = Time.now.strftime("%Y%m%d%H%M")

    # Build the signed .ipa (archive + export).
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )

    # Upload to TestFlight without blocking on Apple's processing.
    upload_to_testflight(api_key_path: ASC_KEY, skip_waiting_for_build_processing: true)
  end

  desc "Promote the latest build for App Store review"
  lane :release do
    match(type: "appstore", readonly: is_ci, api_key_path: ASC_KEY, force_legacy_encryption: MATCH_LEGACY)
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store"
    )
    # Submit metadata + binary. Configure metadata under fastlane/metadata/.
    upload_to_app_store(
      api_key_path: ASC_KEY,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
