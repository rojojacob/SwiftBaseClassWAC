# fastlane Fastfile
# Run a lane with:  bundle exec fastlane <lane>
# Docs: https://docs.fastlane.tools
#
# Prerequisites (one-time): see docs/RELEASE_SETUP.md
#   - `bundle install`  (installs fastlane from the Gemfile)
#   - A private "match" repo for signing assets (set MATCH_GIT_URL)
#   - An App Store Connect API key (.p8) + Key ID + Issuer ID for uploads.
#
# Credentials are read from the environment (see fastlane/.env.example).
# Locally, copy it to fastlane/.env (gitignored); in CI, set repo secrets.

default_platform(:ios)

SCHEME = "SwiftBaseClassWAC"
PROJECT = "SwiftBaseClassWAC/SwiftBaseClassWAC.xcodeproj"

# Authenticate with the App Store Connect API key. Returns a key hash that
# match / pilot / deliver pick up automatically via lane context, so uploads
# never fall back to interactive Apple-ID + 2FA login (which breaks on CI).
def load_asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
    in_house: false
  )
end

platform :ios do
  desc "Run the full test suite (mirrors CI)"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: ["iPhone 16"]
    )
  end

  desc "Build a signed .ipa and upload to TestFlight (internal + external testing)"
  lane :beta do
    api_key = load_asc_api_key

    # Sync signing assets from the private match repo (read-only on CI).
    match(type: "appstore", readonly: is_ci, api_key: api_key)

    # Bump the build number so each upload is unique.
    increment_build_number(xcodeproj: PROJECT)

    # Build the .ipa (archive + export).
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store"
    )

    # Upload to TestFlight without blocking on Apple's processing.
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Promote the latest build for App Store review"
  lane :release do
    api_key = load_asc_api_key

    match(type: "appstore", readonly: is_ci, api_key: api_key)
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store"
    )
    # Submit metadata + binary. Configure metadata under fastlane/metadata/.
    upload_to_app_store(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
