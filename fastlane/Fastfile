# fastlane Fastfile
# Run a lane with:  bundle exec fastlane <lane>
# Docs: https://docs.fastlane.tools
#
# Prerequisites (one-time): see docs/RELEASE_SETUP.md
#   - `bundle install`  (installs fastlane from the Gemfile)
#   - A private "match" repo for signing assets (set MATCH_GIT_URL)
#   - An App Store Connect API key (.p8) + Key ID + Issuer ID.
#
# Credentials are read from the environment (see fastlane/.env.example).
# The API key is supplied to match/pilot/deliver as a JSON file via
# `api_key_path` (generated locally / from CI secrets; gitignored).

default_platform(:ios)

SCHEME = "SwiftBaseClassWAC"
PROJECT = "SwiftBaseClassWAC/SwiftBaseClassWAC.xcodeproj"
APP_IDENTIFIER = "com.wac.SwiftBaseClassWAC"
APP_VERSION = "1.0.0" # marketing version; keep in sync with MARKETING_VERSION in the project
ASC_KEY = "fastlane/asc_api_key.json"

# macOS system Ruby links LibreSSL, whose AES-GCM binding (match's default v2
# encryption) is broken; legacy AES-256-CBC works and is still decryptable by
# OpenSSL-3 machines (e.g. CI). Force it so match storage is portable.
MATCH_LEGACY = true

# Next build number for a version train: (max existing build number for that
# CFBundleShortVersionString) + 1, or 1 if none. latest_testflight_build_number
# returns the GLOBAL latest regardless of version, so we filter explicitly here
# to keep build numbers clean (1, 2, 3, ...) per version.
def next_build_number(version)
  require "spaceship"
  # Absolute path: inside a lane fastlane's CWD is the fastlane/ dir, so a
  # root-relative path wouldn't resolve here.
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from_json_file(File.join(__dir__, "asc_api_key.json"))
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  builds = app.get_builds(includes: "preReleaseVersion", limit: 200)
  nums = builds.select { |b| b.pre_release_version&.version == version }.map { |b| b.version.to_i }
  (nums.max || 0) + 1
end

platform :ios do
  desc "Run the full test suite (mirrors CI)"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: ["iPhone 16"]
    )
  end

  desc "Generate / sync App Store signing assets via match"
  lane :certificates do
    match(type: "appstore", api_key_path: ASC_KEY, force_legacy_encryption: MATCH_LEGACY)
  end

  desc "Build a signed .ipa and upload to TestFlight (internal + external testing)"
  lane :beta do
    # On CI, create a temporary, unlocked keychain and set the key partition
    # list so codesign can use the match-imported private key NON-interactively.
    # Without this, codesign hangs forever waiting for a GUI keychain prompt
    # that never appears on a headless runner. No-op locally.
    setup_ci

    # Clean, incrementing build number per version train: 1.0.0 (1), 1.0.0 (2)...
    # Computed first so a failure here doesn't leave the project mutated.
    build_number = next_build_number(APP_VERSION)

    # Sync signing assets from the private match repo (read-only on CI).
    match(type: "appstore", readonly: is_ci, api_key_path: ASC_KEY, force_legacy_encryption: MATCH_LEGACY)
    profile = ENV.fetch("sigh_#{APP_IDENTIFIER}_appstore_profile-name")

    # The project uses Automatic signing for day-to-day development (⌘R).
    # Force Manual signing with the match profile for the release archive —
    # automatic signing can't resolve on a headless CI runner.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      team_id: "T92Y92RB48",
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
      targets: [SCHEME]
    )

    # Build the signed .ipa (archive + export).
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: "MARKETING_VERSION=#{APP_VERSION} CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => profile }
      }
    )

    # Upload to TestFlight without blocking on Apple's processing.
    upload_to_testflight(api_key_path: ASC_KEY, skip_waiting_for_build_processing: true)
  end

  desc "Promote the latest build for App Store review"
  lane :release do
    setup_ci # temporary CI keychain so codesign doesn't hang (see :beta)
    match(type: "appstore", readonly: is_ci, api_key_path: ASC_KEY, force_legacy_encryption: MATCH_LEGACY)
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store"
    )
    # Submit metadata + binary. Configure metadata under fastlane/metadata/.
    upload_to_app_store(
      api_key_path: ASC_KEY,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
