# Copy this file to `fastlane/.env` (gitignored) and fill in your values.
# In CI, set these as GitHub Actions repository secrets instead.
# See docs/RELEASE_SETUP.md for where each value comes from.

# Apple Developer account email (used by fastlane for non-API operations)
FASTLANE_APPLE_ID=

# App Store Connect API key (from App Store Connect → Users and Access →
# Integrations → App Store Connect API). The .p8 is downloadable only once.
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=fastlane/AuthKey_XXXXXXXXXX.p8

# fastlane match — the SEPARATE PRIVATE git repo holding encrypted signing assets
MATCH_GIT_URL=
MATCH_PASSWORD=
