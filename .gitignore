# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# ---------------------------------------------------------------------------
# Xcode — user-specific & build artifacts
# ---------------------------------------------------------------------------
## User settings
xcuserdata/
*.xcuserstate
*.xcscmblueprint

## Build output
build/
DerivedData/
*.xcarchive
*.ipa
*.dSYM.zip
*.dSYM

## Xcode injected / generated
*.moved-aside
*.hmap
*.ipa

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# ---------------------------------------------------------------------------
# Swift Package Manager
# ---------------------------------------------------------------------------
.build/
.swiftpm/
Package.resolved
# Keep the SPM config the project workspace tracks:
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# ---------------------------------------------------------------------------
# CocoaPods / Carthage (only relevant if added later)
# ---------------------------------------------------------------------------
Pods/
Carthage/Build/

# ---------------------------------------------------------------------------
# fastlane
# ---------------------------------------------------------------------------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/
fastlane/README.md

## Signing assets & credentials must never be committed in the clear
*.mobileprovision
*.p12
*.cer
*.certSigningRequest
*.p8
AuthKey_*.p8
fastlane/.env
fastlane/asc_api_key.json
# (fastlane/.env.example IS committed as a template)

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.lefthook-local/
*.log

# ---------------------------------------------------------------------------
# Ruby / Bundler (fastlane)
# ---------------------------------------------------------------------------
vendor/
.bundle/cache/
# Gemfile.lock is NOT committed: it is generated by the local system Ruby 2.6
# (bundler 1.17.2 / older gem pins) and is incompatible with the Ruby 3.x used
# in CI. The fastlane version is pinned in the Gemfile instead. CI resolves a
# fresh, platform-correct lock each run.
Gemfile.lock

# ---------------------------------------------------------------------------
# Editor / assistant local settings
# ---------------------------------------------------------------------------
.claude/settings.local.json

# xcconfig secrets (real file is local-only)
SwiftBaseClassWAC/Config/Secrets.xcconfig
